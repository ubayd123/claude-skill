# ---- Core ----
# Public URL of the site (used in emails, sitemap, canonical links)
SITE_URL=https://www.example.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Set to "require" on hosted Postgres (Neon, Supabase, RDS...)
DATABASE_SSL=

# ---- Enquiry recipient ----
ENQUIRY_TO=redlighttherapyco.26@gmail.com

# ---- Transactional email (choose ONE) ----
# Option A: Resend (recommended). Verify your sending domain in Resend to get SPF + DKIM.
RESEND_API_KEY=
# Option B: any SMTP provider (Postmark, SES, Brevo, Gmail with an app password...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From address. Must be on a domain you have verified with the provider.
EMAIL_FROM="Redlight Therapy Co. <enquiries@yourdomain.com>"

# ---- First admin account (used once by `npm run db:seed`) ----
ADMIN_EMAIL=redlighttherapyco.26@gmail.com
ADMIN_PASSWORD=

# ---- File uploads on Vercel: set automatically when you connect Vercel Blob ----
BLOB_READ_WRITE_TOKEN=

# ---- Secret used to hash IP addresses for rate limiting (any long random string) ----
APP_SECRET=
